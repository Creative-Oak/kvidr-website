# ---- Sanity ----------------------------------------------------------------
PUBLIC_SANITY_PROJECT_ID="9c35nr1d"
PUBLIC_SANITY_DATASET="production"

# Turn on Presentation / live preview. Keep "false" in production.
PUBLIC_SANITY_VISUAL_EDITING_ENABLED="false"

# Viewer token. Required whenever visual editing is on (drafts + stega).
# sanity.io/manage -> your project -> API -> Tokens -> Add API token (Viewer)
SANITY_API_READ_TOKEN=""

# ---- Site ------------------------------------------------------------------
PUBLIC_SITE_URL="https://kvidr.app"

# ---- Resend ----------------------------------------------------------------
RESEND_API_KEY=""
RESEND_AUDIENCE_ID=""
RESEND_FROM_EMAIL="kvidr <hello@kvidr.app>"
CONTACT_TO_EMAIL="hello@kvidr.app"

# ---- Umami (optional; both must be set for the script to render) -----------
PUBLIC_UMAMI_SCRIPT_URL=""
PUBLIC_UMAMI_WEBSITE_ID=""

# Pre-launch the /pricing page redirects to the launch sign-up. Set to true at launch.
PUBLIC_SHOW_PRICING=false
