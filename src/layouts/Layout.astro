---
import '@fontsource-variable/schibsted-grotesk'
import '@fontsource-variable/newsreader'
import '../styles/global.css'

import {VisualEditing} from '@sanity/astro/visual-editing'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import {loadQuery} from '../sanity/lib/load-query'
import {siteSettingsQuery} from '../sanity/lib/queries'
import {urlForImage} from '../sanity/lib/image'
import {clean} from '../sanity/lib/stega'

interface Props {
  title?: string
  description?: string
  image?: any
  /** Omit from search indexes (e.g. the studio). */
  noindex?: boolean
  type?: 'website' | 'article'
  publishedTime?: string
}

const {title, description, image, noindex = false, type = 'website', publishedTime} = Astro.props

const {data: settings} = await loadQuery<any>({query: siteSettingsQuery})

const siteName = 'kvidr'
const fallbackTitle = settings?.seo?.title ?? 'kvidr — native Nextcloud Talk for Mac and iPhone'
const fallbackDescription =
  settings?.seo?.description ??
  'Nextcloud Talk as genuinely native apps for Mac and iPhone. Open source under MIT, and not launched yet.'

// Everything below goes into <title> or a meta attribute, never into visible
// text, so stega has to come off — otherwise the invisible characters end up in
// search results and social cards.
const pageTitle = clean(title ? `${title} — ${siteName}` : fallbackTitle)
const pageDescription = clean(description ?? fallbackDescription)

const shareSource = image ?? settings?.seo?.image
const shareImage = shareSource?.asset
  ? urlForImage(shareSource).width(1200).height(630).fit('crop').url()
  : new URL('/og.png', Astro.site ?? Astro.url).toString()

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString()

const visualEditingEnabled = import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED === 'true'

const umamiSrc = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID
const umamiEnabled = Boolean(umamiSrc && umamiId)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f7fafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1520" media="(prefers-color-scheme: dark)" />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={shareImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    {umamiEnabled && <script is:inline defer src={umamiSrc} data-website-id={umamiId} />}
  </head>

  <body>
    <SiteHeader navLinks={settings?.navLinks ?? []} githubUrl={settings?.githubUrl} />

    <main id="main">
      <slot />
    </main>

    <SiteFooter
      tagline={settings?.tagline}
      footerLinks={settings?.footerLinks ?? []}
      footerNote={settings?.footerNote}
      githubUrl={settings?.githubUrl}
      contactEmail={settings?.contactEmail}
    />

    <VisualEditing enabled={visualEditingEnabled} zIndex={1000} />

    <script>
      // One motion idea, applied everywhere: content rises into place as it enters
      // the viewport, staggered by document order within each group.
      const reveal = () => {
        const items = document.querySelectorAll<HTMLElement>('[data-reveal]')
        if (!items.length) return

        if (
          !('IntersectionObserver' in window) ||
          window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          items.forEach((el) => el.classList.add('is-in'))
          return
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries
              .filter((entry) => entry.isIntersecting)
              .forEach((entry, index) => {
                const el = entry.target as HTMLElement
                if (!el.style.getPropertyValue('--reveal-delay')) {
                  el.style.setProperty('--reveal-delay', `${Math.min(index, 6) * 70}ms`)
                }
                el.classList.add('is-in')
                observer.unobserve(el)
              })
          },
          {rootMargin: '0px 0px -8% 0px', threshold: 0.08},
        )

        items.forEach((el) => observer.observe(el))
      }

      reveal()
      document.addEventListener('astro:page-load', reveal)
    </script>
  </body>
</html>
