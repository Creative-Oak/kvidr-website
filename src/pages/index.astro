---
import AppIcon from '../components/AppIcon.astro'
import Glyph from '../components/Glyph.astro'
import PhoneFrame from '../components/PhoneFrame.astro'
import PortableText from '../components/PortableText.astro'
import SectionLabel from '../components/SectionLabel.astro'
import ShortcutList from '../components/ShortcutList.astro'
import SubscribeForm from '../components/SubscribeForm.astro'
import WindowFrame from '../components/WindowFrame.astro'
import Layout from '../layouts/Layout.astro'
import {loadQuery} from '../sanity/lib/load-query'
import {homePageQuery, siteSettingsQuery} from '../sanity/lib/queries'
import {clean} from '../sanity/lib/stega'
import {formatPrice, withPrice} from '../lib/price'

const [{data: home}, {data: settings}] = await Promise.all([
  loadQuery<any>({query: homePageQuery}),
  loadQuery<any>({query: siteSettingsQuery}),
])

const headline = home?.headline ?? 'Nextcloud Talk,\nfinally at home\non the Mac.'
const downloadUrl = clean(settings?.downloadUrl)
const githubUrl = clean(settings?.githubUrl)
const iosAppStoreUrl = clean(settings?.iosAppStoreUrl)
const hasDownload = Boolean(downloadUrl)
const price = formatPrice(settings)

// "https://github.com/owner/repo" → "repo", for the clone snippet.
const repoDir = githubUrl?.replace(/\/+$/, '').split('/').pop()

/*
 * Section numbers are counted, not typed. An empty section does not render,
 * and a hard-coded "05" would then sit under "03" with nothing in between.
 */
const sectionOrder = [
  ['problem', Boolean(home?.problemHeading)],
  ['qualities', home?.qualities?.length > 0],
  ['features', home?.features?.length > 0],
  ['keyboard', home?.shortcuts?.length > 0],
  ['ios', Boolean(home?.iosHeading)],
  ['privacy', Boolean(home?.privacyHeading)],
  ['pricing', Boolean(home?.pricingHeading)],
  ['requirements', home?.requirements?.length > 0],
] as const

const visible = sectionOrder.filter(([, shown]) => shown).map(([key]) => key)
const num = (key: (typeof sectionOrder)[number][0]) =>
  String(visible.indexOf(key) + 1).padStart(2, '0')

// Structured data, so search engines can show what kvidr is and what it costs.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'kvidr',
  description: clean(home?.seo?.description ?? home?.lede),
  applicationCategory: 'CommunicationApplication',
  operatingSystem: 'macOS 26',
  license: 'https://opensource.org/license/mit',
  url: new URL('/', Astro.site ?? Astro.url).toString(),
  ...(githubUrl ? {sameAs: [githubUrl]} : {}),
  ...(typeof settings?.priceAmount === 'number'
    ? {
        offers: {
          '@type': 'Offer',
          price: settings.priceAmount.toFixed(2),
          priceCurrency: clean(settings?.priceCurrency) || 'USD',
          ...(downloadUrl ? {url: downloadUrl} : {}),
        },
      }
    : {}),
}
// Escape "<" so nothing in the CMS can close the script element early.
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c')
---

<Layout
  description={home?.seo?.description}
  image={home?.seo?.image}
>
  <!-- ================= Hero ================= -->
  <section class="hero">
    <div class="shell">
      {home?.eyebrow && <p class="t-label hero__eyebrow" data-reveal>{home.eyebrow}</p>}

      <h1 class="t-hero hero__headline" data-reveal style="--reveal-delay:60ms">
        {headline}
      </h1>

      <div class="hero__row">
        <div class="hero__pitch" data-reveal style="--reveal-delay:140ms">
          <p class="t-lede">{home?.lede}</p>

          <div class="hero__actions">
            {
              hasDownload ? (
                <a class="btn btn--accent" href={downloadUrl}>
                  Buy for Mac{price && <span class="btn__price">{price}</span>}
                </a>
              ) : (
                githubUrl && (
                  <a
                    class="btn btn--accent"
                    href={githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Read the source
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M7 17 17 7M9 7h8v8" />
                    </svg>
                  </a>
                )
              )
            }
            <a class="btn btn--ghost" href={home?.pricingHeading ? '#get' : '#keyboard'}>
              {home?.pricingHeading ? 'How to get it' : 'See the shortcuts'}
            </a>
          </div>

          {
            home?.heroPriceNote && (
              <p class="t-small hero__price">{withPrice(home.heroPriceNote, price)}</p>
            )
          }

          {
            home?.statusNote && (
              <p class="t-small hero__status">
                <span class="hero__dot" aria-hidden="true" />
                {home.statusNote}
              </p>
            )
          }
        </div>
      </div>

      <div class="hero__frame" data-reveal style="--reveal-delay:220ms">
        <WindowFrame image={home?.heroScreenshot} hero sizes="(max-width: 80rem) 92vw, 74rem" />
      </div>
    </div>
  </section>

  <!-- ================= The problem ================= -->
  {
    home?.problemHeading && (
      <section class="section section--ruled">
        <div class="shell spine">
          <SectionLabel num={num('problem')}>The problem</SectionLabel>

          <div>
            <h2 class="t-h2 measure-tight" data-reveal>{home.problemHeading}</h2>
            <div class="problem__body" data-reveal style="--reveal-delay:80ms">
              <PortableText value={home.problemBody} />
            </div>

            {home.problemScreenshot?.asset && (
              <div class="problem__shot" data-reveal style="--reveal-delay:140ms">
                <WindowFrame
                  image={home.problemScreenshot}
                  sizes="(max-width: 62rem) 92vw, 48rem"
                />
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  <!-- ================= How it feels ================= -->
  {
    home?.qualities?.length > 0 && (
      <section class="section section--ruled">
        <div class="shell spine">
          <SectionLabel num={num('qualities')}>How it feels</SectionLabel>

          <div>
            <h2 class="t-h2 measure-tight" data-reveal>{home.qualitiesHeading}</h2>

            <ol class="qualities" role="list">
              {home.qualities.map((q: any, i: number) => (
                <li class="quality" data-reveal style={`--reveal-delay:${i * 70}ms`}>
                  <span class="t-label quality__num">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="t-h3 quality__title">{q.title}</h3>
                  <p class="t-prose quality__body">{q.body}</p>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>
    )
  }

  <!-- ================= Features ================= -->
  {
    home?.features?.length > 0 && (
      <section class="section section--ruled">
        <div class="shell spine">
          <SectionLabel num={num('features')}>What it does</SectionLabel>

          <div>
            <h2 class="t-h2 measure-tight" data-reveal>{home.featuresHeading}</h2>
            {home.featuresIntro && (
              <p class="t-lede features__intro measure" data-reveal style="--reveal-delay:70ms">
                {home.featuresIntro}
              </p>
            )}

            <ul class="features" role="list">
              {home.features.map((f: any, i: number) => (
                <li class="feature" data-reveal style={`--reveal-delay:${Math.min(i, 8) * 55}ms`}>
                  <span class="feature__icon" aria-hidden="true">
                    <Glyph name={f.symbol ?? 'bubble'} size={18} />
                  </span>
                  <h3 class="feature__title">{f.title}</h3>
                  <p class="t-small feature__body">{f.body}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>

        {home.featureScreenshots?.length > 0 && (
          <div class="gallery" data-reveal>
            <div class="gallery__track">
              {home.featureScreenshots.map((shot: any) => (
                <div class="gallery__item">
                  <WindowFrame image={shot} sizes="(max-width: 48rem) 84vw, 38rem" />
                </div>
              ))}
            </div>
          </div>
        )}
      </section>
    )
  }

  <!-- ================= Keyboard ================= -->
  {
    home?.shortcuts?.length > 0 && (
      <section class="section section--ruled" id="keyboard">
        <div class="shell spine">
          <SectionLabel num={num('keyboard')}>Keyboard</SectionLabel>

          <div>
            <h2 class="t-h2 measure-tight" data-reveal>{home.keyboardHeading}</h2>
            {home.keyboardIntro && (
              <p class="t-lede keyboard__intro measure" data-reveal style="--reveal-delay:70ms">
                {home.keyboardIntro}
              </p>
            )}

            <div class="keyboard__list">
              <ShortcutList shortcuts={home.shortcuts} />
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- ================= iPhone ================= -->
  {
    home?.iosHeading && (
      <section class="section section--ruled" id="iphone">
        <div class="shell spine">
          <SectionLabel num={num('ios')}>iPhone</SectionLabel>

          <div class="ios">
            <div class="ios__text">
              {!iosAppStoreUrl && home.iosStatus && (
                <p class="ios__status t-label" data-reveal>
                  <span class="ios__pulse" aria-hidden="true" />
                  {home.iosStatus}
                </p>
              )}
              <h2 class="t-h2 measure-tight" data-reveal style="--reveal-delay:40ms">
                {home.iosHeading}
              </h2>
              <div data-reveal style="--reveal-delay:100ms">
                <PortableText value={home.iosBody} class="ios__body" />
              </div>
              {iosAppStoreUrl && (
                <a class="btn btn--accent ios__cta" href={iosAppStoreUrl} data-reveal>
                  View on the App Store
                </a>
              )}
            </div>

            <div class="ios__device" data-reveal style="--reveal-delay:160ms">
              <PhoneFrame image={home.iosScreenshot} />
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- ================= Privacy ================= -->
  {
    home?.privacyHeading && (
      <section class="section section--ruled">
        <div class="shell spine">
          <SectionLabel num={num('privacy')}>Credentials</SectionLabel>

          <div class="privacy">
            <h2 class="t-h2 measure-tight" data-reveal>{home.privacyHeading}</h2>
            <div data-reveal style="--reveal-delay:80ms">
              <PortableText value={home.privacyBody} />
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- ================= Price ================= -->
  {
    home?.pricingHeading && (
      <section class="section section--ruled" id="get">
        <div class="shell spine">
          <SectionLabel num={num('pricing')}>Price</SectionLabel>

          <div>
            <h2 class="t-h2 measure-tight pricing__heading" data-reveal>
              {withPrice(home.pricingHeading, price)}
            </h2>
            {home.pricingIntro && (
              <p class="t-lede measure pricing__intro" data-reveal style="--reveal-delay:70ms">
                {home.pricingIntro}
              </p>
            )}

            <div class="options">
              <article class="option option--buy" data-reveal>
                <p class="t-label option__kicker">{home.buyTitle ?? 'Get the signed build'}</p>
                <p class="option__price">{price ?? 'Paid'}</p>
                <p class="t-prose option__body">{withPrice(home.buyBody, price)}</p>
                {hasDownload ? (
                  <a class="btn btn--accent option__cta" href={downloadUrl}>
                    Buy for Mac{price && <span class="btn__price">{price}</span>}
                  </a>
                ) : (
                  <p class="option__soon t-small">
                    <span class="option__soondot" aria-hidden="true" />
                    The signed build is on its way
                  </p>
                )}
              </article>

              <article class="option option--build" data-reveal style="--reveal-delay:90ms">
                <p class="t-label option__kicker">{home.buildTitle ?? 'Build it yourself'}</p>
                <p class="option__price">Free</p>
                <p class="t-prose option__body">{home.buildBody}</p>
                {githubUrl && repoDir && (
                  <pre class="option__code" aria-label="Commands to build kvidr yourself"><code><span class="option__line"><span class="option__prompt">$ </span>git clone {githubUrl}</span><span class="option__line"><span class="option__prompt">$ </span>open {repoDir}/Kvidr.xcodeproj</span></code></pre>
                )}
                {githubUrl && (
                  <a class="btn btn--ghost option__cta" href={githubUrl} target="_blank" rel="noopener noreferrer">
                    Read the source
                  </a>
                )}
                <p class="t-label option__licence">MIT licence</p>
              </article>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- ================= Requirements ================= -->
  {
    home?.requirements?.length > 0 && (
      <section class="section section--ruled">
        <div class="shell spine">
          <SectionLabel num={num('requirements')}>Requirements</SectionLabel>

          <div>
            <h2 class="t-h2 measure-tight" data-reveal>{home.requirementsHeading}</h2>
            {home.requirementsIntro && (
              <p class="t-lede measure requirements__intro" data-reveal style="--reveal-delay:70ms">
                {home.requirementsIntro}
              </p>
            )}

            <dl class="requirements">
              {home.requirements.map((r: any, i: number) => (
                <div class="requirement" data-reveal style={`--reveal-delay:${i * 60}ms`}>
                  <dt class="requirement__term">{r.title}</dt>
                  <dd class="requirement__desc t-small">{r.body}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </section>
    )
  }

  <!-- ================= CTA ================= -->
  <section class="section section--ruled cta">
    <div class="shell cta__inner">
      <div>
        <div class="cta__icon" data-reveal>
          <AppIcon size={120} />
        </div>
        <h2 class="t-h2 measure-tight" data-reveal>
          {home?.ctaHeading ?? 'Want to know when it runs?'}
        </h2>
        {
          home?.ctaBody && (
            <p class="t-lede measure cta__body" data-reveal style="--reveal-delay:70ms">
              {home.ctaBody}
            </p>
          )
        }
      </div>

      <div class="cta__form" data-reveal style="--reveal-delay:140ms">
        <SubscribeForm label={home?.ctaSubscribeLabel ?? 'Keep me posted'} />
      </div>
    </div>
  </section>

  <script type="application/ld+json" is:inline set:html={structuredDataJson} />
</Layout>

<style>
  /* ---- Hero ---- */
  .hero {
    padding-top: clamp(3.5rem, 9vw, 8rem);
    padding-bottom: clamp(3rem, 7vw, 6rem);
    position: relative;
  }

  .hero__eyebrow {
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }

  .hero__headline {
    white-space: pre-line;
    max-width: 15ch;
  }

  /* The asymmetry: the pitch sits off-centre, under the headline's right half. */
  .hero__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-top: clamp(1.75rem, 4vw, 3rem);
  }

  @media (min-width: 62rem) {
    .hero__row {
      grid-template-columns: 4fr 6fr;
    }

    .hero__pitch {
      grid-column: 2;
    }
  }

  .hero__pitch .t-lede {
    max-width: 46ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .hero__status {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    margin-top: 1.5rem;
    color: var(--ink-3);
    max-width: 46ch;
  }

  .hero__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--teal-deep);
    box-shadow: 0 0 0 3px var(--teal-wash);
    flex: none;
    transform: translateY(-1px);
  }

  .hero__price {
    margin-top: 1rem;
    color: var(--ink-2);
    max-width: 46ch;
  }

  .hero__frame {
    margin-top: clamp(3rem, 8vw, 6rem);
  }

  /* ---- 01 Problem ---- */
  .problem__body {
    margin-top: 1.75rem;
  }

  .problem__shot {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    max-width: 48rem;
  }

  /* ---- 02 Qualities ---- */
  .qualities {
    list-style: none;
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--rule);
    border-block: 1px solid var(--rule);
  }

  @media (min-width: 48rem) {
    .qualities {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .quality {
    background: var(--paper);
    padding: clamp(1.5rem, 3vw, 2.25rem) clamp(1.25rem, 3vw, 2.25rem);
    transition: background-color 0.3s var(--ease);
  }

  .quality:hover {
    background: var(--paper-2);
  }

  .quality__num {
    color: var(--teal);
    display: block;
    margin-bottom: 1rem;
  }

  .quality__body {
    margin-top: 0.6rem;
    max-width: 42ch;
    font-size: 1rem;
  }

  /* ---- 03 Features ---- */
  .features__intro {
    margin-top: 1.5rem;
  }

  .features {
    list-style: none;
    margin: clamp(2.5rem, 6vw, 3.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: clamp(1.75rem, 4vw, 2.75rem) clamp(1.75rem, 4vw, 3rem);
  }

  .feature__icon {
    display: grid;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 10px;
    background: var(--accent-wash);
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .feature:nth-child(even) .feature__icon {
    background: var(--teal-wash);
    color: var(--teal);
  }

  .feature__title {
    font-size: 1rem;
    font-weight: 620;
    letter-spacing: -0.015em;
  }

  .feature__body {
    margin-top: 0.4rem;
    max-width: 34ch;
    color: var(--ink-2);
  }

  /* A horizontally scrolling row that deliberately breaks the grid. */
  .gallery {
    margin-top: clamp(3rem, 7vw, 5rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-block: 0.5rem;
  }

  .gallery::-webkit-scrollbar {
    display: none;
  }

  .gallery__track {
    display: flex;
    gap: clamp(1rem, 2.5vw, 2rem);
    padding-inline: var(--gutter);
    width: max-content;
  }

  .gallery__item {
    width: min(38rem, 84vw);
    flex: none;
    scroll-snap-align: center;
  }

  /* ---- 04 Keyboard ---- */
  .keyboard__intro {
    margin-top: 1.5rem;
  }

  .keyboard__list {
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  /* ---- 05 Privacy ---- */
  .privacy :global(.pt) {
    margin-top: 1.75rem;
  }

  /* ---- 06 Requirements ---- */
  .requirements__intro {
    margin-top: 1.5rem;
  }

  .requirements {
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    display: grid;
    gap: 0;
  }

  .requirement {
    display: grid;
    gap: 0.35rem 2rem;
    padding-block: 1.15rem;
    border-top: 1px solid var(--rule);
  }

  .requirement:last-child {
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 48rem) {
    .requirement {
      grid-template-columns: 16rem minmax(0, 1fr);
      align-items: baseline;
    }
  }

  .requirement__term {
    font-weight: 620;
    font-size: 1rem;
    letter-spacing: -0.015em;
  }

  .requirement__desc {
    margin: 0;
    max-width: 52ch;
  }

  /* ---- CTA ---- */
  .cta__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  @media (min-width: 62rem) {
    .cta__inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  .cta__icon {
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
    /* Drawn a touch past the column edge so the squircle's optical margin
       lines up with the headline's cap height rather than its box. */
    margin-left: -0.45rem;
  }

  .cta__icon :global(.app-icon) {
    animation: cta-float 6s var(--ease) infinite alternate;
  }

  @keyframes cta-float {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-6px);
    }
  }

  /* On wide screens, start the form level with the headline, not with the
     icon above it. */
  @media (min-width: 62rem) {
    .cta__form {
      padding-top: calc(120px + clamp(1.5rem, 3vw, 2.25rem) + 0.6rem);
    }
  }

  .cta__body {
    margin-top: 1.25rem;
  }

  /* ---- iPhone ---- */
  .ios {
    display: grid;
    gap: clamp(3rem, 7vw, 5rem);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .ios {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  .ios__status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 1.25rem;
    padding: 0.4rem 0.8rem 0.4rem 0.65rem;
    border-radius: 999px;
    color: var(--teal);
    background: var(--teal-wash);
  }

  .ios__pulse {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--teal-deep);
  }

  .ios__pulse::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1.5px solid var(--teal-deep);
    opacity: 0;
    animation: ios-pulse 2.4s var(--ease-out) infinite;
  }

  @keyframes ios-pulse {
    0% {
      transform: scale(0.5);
      opacity: 0.8;
    }
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  .ios :global(.ios__body) {
    margin-top: 1.75rem;
  }

  .ios__cta {
    margin-top: 2rem;
  }

  .ios__device {
    display: flex;
    justify-content: center;
  }

  /* ---- Price ---- */
  .pricing__heading {
    white-space: pre-line;
  }

  .pricing__intro {
    margin-top: 1.5rem;
  }

  .options {
    display: grid;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    gap: 1px;
    background: var(--rule);
    border-block: 1px solid var(--rule);
  }

  @media (min-width: 48rem) {
    .options {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .option {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background: var(--paper);
    padding: clamp(1.75rem, 4vw, 2.75rem) clamp(1.25rem, 3vw, 2.5rem);
  }

  .option__kicker {
    color: var(--teal);
  }

  .option--buy .option__kicker {
    color: var(--accent);
  }

  .option__price {
    margin-top: 0.9rem;
    font-family: var(--font-display);
