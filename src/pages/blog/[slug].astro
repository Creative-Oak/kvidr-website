---
import PortableText from '../../components/PortableText.astro'
import SanityImage from '../../components/SanityImage.astro'
import Layout from '../../layouts/Layout.astro'
import {loadQuery} from '../../sanity/lib/load-query'
import {postQuery} from '../../sanity/lib/queries'

const {slug} = Astro.params

if (!slug) {
  return new Response(null, {status: 404, statusText: 'Not found'})
}

const {data: post} = await loadQuery<any>({query: postQuery, params: {slug}})

if (!post) {
  return new Response(null, {status: 404, statusText: 'Not found'})
}

const formatDate = (value: string) =>
  new Date(value).toLocaleDateString('en-GB', {day: 'numeric', month: 'long', year: 'numeric'})
---

<Layout
  title={post.title}
  description={post.seo?.description ?? post.excerpt}
  image={post.seo?.image ?? post.coverImage}
  type="article"
  publishedTime={post.publishedAt}
>
  <article class="post">
    <header class="post__head shell">
      <a class="post__back link-arrow" href="/blog">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H6M12 19l-7-7 7-7" />
        </svg>
        All writing
      </a>

      <p class="t-label post__meta" data-reveal>
        <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
        {post.author?.name && <><span class="post__dot">·</span>{post.author.name}</>}
      </p>

      <h1 class="t-h2 post__title" data-reveal style="--reveal-delay:60ms">{post.title}</h1>
      <p class="t-lede post__excerpt" data-reveal style="--reveal-delay:120ms">{post.excerpt}</p>
    </header>

    {
      post.coverImage?.asset && (
        <div class="shell post__cover" data-reveal style="--reveal-delay:180ms">
          <SanityImage
            image={post.coverImage}
            alt={post.coverImage.alt ?? ''}
            sizes="(max-width: 80rem) 92vw, 68rem"
            loading="eager"
            class="post__coverimg"
          />
          {post.coverImage.caption && (
            <p class="t-small post__covercaption">{post.coverImage.caption}</p>
          )}
        </div>
      )
    }

    <div class="shell post__bodywrap">
      <PortableText value={post.body} class="post__body" />
    </div>

    {
      post.author?.name && (
        <footer class="shell post__author">
          <div class="post__authorinner">
            {post.author.image?.asset && (
              <SanityImage
                image={post.author.image}
                alt=""
                widths={[96, 192]}
                sizes="48px"
                class="post__avatar"
              />
            )}
            <div>
              <p class="post__authorname">{post.author.name}</p>
              {post.author.role && <p class="t-small">{post.author.role}</p>}
              {post.author.bio && <p class="t-small post__bio">{post.author.bio}</p>}
            </div>
          </div>
        </footer>
      )
    }
  </article>
</Layout>

<style>
  .post__head {
    padding-top: clamp(3rem, 7vw, 5.5rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .post__back {
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  .post__back:hover {
    color: var(--accent);
  }

  .post__meta {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .post__dot {
    margin-inline: 0.5em;
  }

  .post__title {
    margin-top: 1rem;
    max-width: 22ch;
  }

  .post__excerpt {
    margin-top: 1.5rem;
    max-width: 50ch;
  }

  .post__cover :global(.post__coverimg) {
    width: 100%;
    border-radius: var(--radius-m);
    border: 1px solid var(--rule);
    box-shadow: var(--glass-shadow);
  }

  .post__covercaption {
    margin-top: 0.85rem;
    color: var(--ink-3);
  }

  .post__bodywrap {
    padding-top: clamp(2.5rem, 6vw, 4rem);
  }

  .post__author {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .post__authorinner {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
    max-width: 64ch;
  }

  .post__authorinner :global(.post__avatar) {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    flex: none;
    object-fit: cover;
  }

  .post__authorname {
    font-weight: 620;
    letter-spacing: -0.015em;
  }

  .post__bio {
    margin-top: 0.5rem;
    max-width: 48ch;
  }
</style>
