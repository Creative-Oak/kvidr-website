---
/**
 * A hand-built stand-in for a real screenshot of kvidr.
 * Deliberately restrained, matching the app's own visual direction:
 * system type, semantic colour, hairline separators, no gradients,
 * no oversized headings. Replaced the moment a real screenshot is uploaded.
 */
interface Props {
  compact?: boolean
}
const {compact = false} = Astro.props

const conversations = [
  {name: 'Design', snippet: 'Anna: the inspector is the right call', time: '09:41', unread: 2, fav: true},
  {name: 'Jonas Bech', snippet: 'Sent you the capability dump', time: '09:28', unread: 0, fav: true},
  {name: 'Release 1.0', snippet: 'You: shipping notes are in the repo', time: 'Tue', unread: 0},
  {name: 'Infrastructure', snippet: 'Mikkel: long poll is stable now', time: 'Tue', unread: 0},
  {name: 'Sofie Lund', snippet: 'Reacted 👍 to your message', time: 'Mon', unread: 0},
]
---

<div class={`mock ${compact ? 'mock--compact' : ''}`} aria-hidden="true">
  <div class="mock__sidebar">
    <div class="mock__search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        ><circle cx="11" cy="11" r="7"></circle><path d="M16.2 16.2 21 21"></path></svg
      >
      <span>Search</span>
      <span class="mock__searchkey">⌘F</span>
    </div>

    <p class="mock__group">Favourites</p>
    {
      conversations.map((c, i) => (
        <div class={`mock__row ${i === 0 ? 'is-selected' : ''}`}>
          <span class={`mock__avatar mock__avatar--${i}`}>{c.name.slice(0, 1)}</span>
          <span class="mock__rowtext">
            <span class="mock__rowtop">
              <span class="mock__name">{c.name}</span>
              <span class="mock__time">{c.time}</span>
            </span>
            <span class="mock__snippet">{c.snippet}</span>
          </span>
          {c.unread > 0 && <span class="mock__badge">{c.unread}</span>}
        </div>
      ))
    }
    {!compact && <p class="mock__group mock__group--late">Conversations</p>}
  </div>

  <div class="mock__main">
    <div class="mock__topbar">
      <span class="mock__title">Design</span>
      <span class="mock__subtitle">4 participants</span>
    </div>

    <div class="mock__transcript">
      <div class="mock__day"><span>Today</span></div>

      <div class="mock__msg">
        <span class="mock__msgavatar mock__avatar--0">A</span>
        <div>
          <p class="mock__sender">Anna Riis</p>
          <p class="mock__bubble">
            The third column should be an inspector, not a dashboard. Participants, shared
            files, that's it.
          </p>
        </div>
      </div>

      <div class="mock__msg mock__msg--out">
        <div>
          <p class="mock__bubble mock__bubble--out">
            Agreed. It follows the platform instead of Talk's web sidebar.
          </p>
          <p class="mock__receipt">Read 09:38</p>
        </div>
      </div>

      <div class="mock__msg">
        <span class="mock__msgavatar mock__avatar--1">J</span>
        <div>
          <p class="mock__sender">Jonas Bech</p>
          <p class="mock__bubble">Long poll has been up for eleven hours without a reconnect.</p>
          <div class="mock__reactions">
            <span class="mock__reaction">🎉 3</span>
            <span class="mock__reaction">👍 2</span>
          </div>
        </div>
      </div>

      <!-- The signature moment: one message lands as the section scrolls in. -->
      <div class="mock__msg mock__msg--arriving" data-mock-arrive>
        <span class="mock__msgavatar mock__avatar--4">S</span>
        <div>
          <p class="mock__sender">Sofie Lund</p>
          <p class="mock__bubble">Launch build is signed and notarised ✨</p>
        </div>
      </div>
    </div>

    <div class="mock__composer">
      <span class="mock__field">Message Design</span>
      <span class="mock__send">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
          ><path d="M12 19V5M6 11l6-6 6 6"></path></svg
        >
      </span>
    </div>
  </div>
</div>

<style>
  .mock {
    display: grid;
    grid-template-columns: 15.5rem minmax(0, 1fr);
    height: 100%;
    background: var(--paper-raised);
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', var(--font-display);
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--ink);
    letter-spacing: -0.006em;
    container-type: inline-size;
  }

  /* --- Sidebar: the one place macOS itself uses vibrancy. --- */
  .mock__sidebar {
    background: color-mix(in srgb, var(--paper-2) 78%, var(--paper-raised));
    border-right: 1px solid var(--rule);
    padding: 0.6rem 0.5rem;
    overflow: hidden;
  }

  .mock__search {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.34rem 0.5rem;
    border-radius: 6px;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    color: var(--ink-3);
    font-size: 0.75rem;
    margin-bottom: 0.7rem;
  }

  .mock__search svg {
    width: 12px;
    height: 12px;
    flex: none;
  }

  .mock__searchkey {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    opacity: 0.75;
  }

  .mock__group {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--ink-3);
    padding: 0.2rem 0.5rem 0.35rem;
    letter-spacing: 0.01em;
  }

  .mock__group--late {
    padding-top: 0.7rem;
  }

  .mock__row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.5rem;
    border-radius: 7px;
  }

  .mock__row.is-selected {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .mock__row.is-selected .mock__time,
  .mock__row.is-selected .mock__snippet {
    color: color-mix(in srgb, var(--accent-ink) 78%, transparent);
  }

  .mock__avatar,
  .mock__msgavatar {
    display: grid;
    place-items: center;
    width: 1.65rem;
    height: 1.65rem;
    flex: none;
    border-radius: 50%;
    font-size: 0.6875rem;
    font-weight: 600;
    color: #fff;
  }

  /* Muted, desaturated avatar colours — not a crayon box. */
  .mock__avatar--0 { background: #6b7fa8; }
  .mock__avatar--1 { background: #8a7f6e; }
  .mock__avatar--2 { background: #6f8a7c; }
  .mock__avatar--3 { background: #8a6f78; }
  .mock__avatar--4 { background: #7a7391; }

  .mock__rowtext {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }

  .mock__rowtop {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem;
  }

  .mock__name {
    font-weight: 590;
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .mock__time {
    font-size: 0.6875rem;
    color: var(--ink-3);
    flex: none;
  }

  .mock__snippet {
    font-size: 0.72rem;
    color: var(--ink-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mock__badge {
    flex: none;
    min-width: 1.15rem;
    height: 1.15rem;
    padding-inline: 0.3rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--paper-raised);
    color: var(--accent);
    font-size: 0.6875rem;
    font-weight: 650;
  }

  /* --- Main column --- */
  .mock__main {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .mock__topbar {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .mock__title {
    font-weight: 620;
    font-size: 0.85rem;
  }

  .mock__subtitle {
    font-size: 0.72rem;
    color: var(--ink-3);
  }

  .mock__transcript {
    flex: 1;
    padding: 0.9rem 1rem;
    display: flex;
    flex-direction: column;
    /* A transcript fills from the bottom, the way every chat app does. */
    justify-content: flex-end;
    gap: 0.75rem;
    overflow: hidden;
  }

  .mock__day {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.6875rem;
    color: var(--ink-3);
  }

  .mock__day::before,
  .mock__day::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--rule);
  }

  .mock__msg {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    max-width: 88%;
  }

  .mock__msg--out {
    margin-left: auto;
    justify-content: flex-end;
    text-align: right;
  }

  .mock__sender {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--ink-2);
    margin-bottom: 0.15rem;
  }

  .mock__bubble {
    display: inline-block;
    padding: 0.42rem 0.7rem;
    border-radius: 13px;
    background: var(--paper-2);
    font-size: 0.78rem;
    text-align: left;
    max-width: 30ch;
  }

  .mock__bubble--out {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .mock__receipt {
    font-size: 0.6375rem;
    color: var(--ink-3);
    margin-top: 0.2rem;
  }

  .mock__reactions {
    display: flex;
    gap: 0.3rem;
    margin-top: 0.3rem;
  }

  .mock__reaction {
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    font-size: 0.6875rem;
    background: var(--glass-bg-strong);
    border: 1px solid var(--rule);
    backdrop-filter: blur(10px) saturate(160%);
    -webkit-backdrop-filter: blur(10px) saturate(160%);
  }

  /* --- The arriving message --- */
  .mock__msg--arriving {
    opacity: 0;
    transform: translateY(8px) scale(0.985);
  }

  :global(.is-in) .mock__msg--arriving {
    animation: mock-arrive 0.55s var(--ease-out) 1.1s forwards;
  }

  @keyframes mock-arrive {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .mock__composer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem 0.75rem;
    border-top: 1px solid var(--rule);
  }

  .mock__field {
    flex: 1;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background: var(--paper-raised);
    color: var(--ink-3);
    font-size: 0.76rem;
  }

  .mock__send {
    display: grid;
    place-items: center;
    width: 1.55rem;
    height: 1.55rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    flex: none;
  }

  .mock__send svg {
    width: 13px;
    height: 13px;
  }

  /* Collapse the sidebar on narrow frames rather than squashing both columns. */
  @container (max-width: 34rem) {
    .mock {
      grid-template-columns: minmax(0, 1fr);
    }

    .mock__sidebar {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mock__msg--arriving {
      opacity: 1;
      transform: none;
    }
  }
</style>
