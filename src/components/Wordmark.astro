---
interface Props {
  /** Render just the mark, without the word. */
  markOnly?: boolean
  size?: number
  class?: string
}

const {markOnly = false, size = 26, class: className = ''} = Astro.props
---

<span class={`wordmark ${className}`} style={`--mark-size:${size}px`}>
  <!-- The logo: a bird in two speech bubbles. "kvidr" is Danish for chirps. -->
  <img
    class="wordmark__mark"
    src="/brand/kvidr-mark.svg"
    alt={markOnly ? 'kvidr' : ''}
    width="1296"
    height="1000"
    decoding="async"
  />
  {!markOnly && <span class="wordmark__word">kvidr</span>}
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.36em;
    font-size: var(--mark-size);
    line-height: 1;
    color: var(--ink);
  }

  .wordmark__mark {
    display: block;
    /* The artwork is wider than tall; size it by height so it optically
       matches the x-height-heavy lowercase word beside it. */
    height: 1.18em;
    width: auto;
    flex: none;
    transform-origin: 30% 80%;
    transition: transform 0.5s var(--ease-out);
  }

  .wordmark__word {
    /* Tight, lowercase, a little loud. Always lowercase. */
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.02em;
    letter-spacing: -0.05em;
    text-transform: lowercase;
  }

  /* A small chirp on hover. */
  :global(a:hover) .wordmark__mark {
    transform: rotate(-6deg) scale(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .wordmark__mark {
      transition: none;
    }
  }
</style>
