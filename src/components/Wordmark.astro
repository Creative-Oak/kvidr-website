---
interface Props {
  /** Render just the mark, without the word. */
  markOnly?: boolean
  size?: number
  class?: string
}

const {markOnly = false, size = 26, class: className = ''} = Astro.props
---

<span class={`wordmark ${className}`} style={`--mark-size:${size}px`}>
  <span class="wordmark__mark" aria-hidden="true">
    <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- A chirp: three ascending strokes. "kvidr" is Danish for chirps. -->
      <rect x="1" y="1" width="30" height="30" rx="9" class="mark__body" />
      <g class="mark__bars" stroke-linecap="round" stroke-width="2.6">
        <path d="M11 19.5v-3" />
        <path d="M16 21.5v-9" />
        <path d="M21 19.5v-6" />
      </g>
    </svg>
  </span>
  {!markOnly && <span class="wordmark__word">kvidr</span>}
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.46em;
    font-size: var(--mark-size);
    line-height: 1;
    color: var(--ink);
  }

  .wordmark__mark {
    display: block;
    width: 1.08em;
    height: 1.08em;
    flex: none;
  }

  .wordmark__mark svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .mark__body {
    fill: var(--ink);
  }

  .mark__bars {
    stroke: var(--paper);
  }

  .wordmark__word {
    /* Tight, lowercase, a little loud. Always lowercase. */
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.02em;
    letter-spacing: -0.05em;
    text-transform: lowercase;
  }

  /* The middle bar grows a hair on hover — a small chirp. */
  .mark__bars path {
    transition: transform 0.4s var(--ease-out);
    transform-origin: bottom;
  }

  a:hover .mark__bars path:nth-child(1) {
    transform: scaleY(1.35);
  }

  a:hover .mark__bars path:nth-child(2) {
    transform: scaleY(0.72);
  }

  a:hover .mark__bars path:nth-child(3) {
    transform: scaleY(1.2);
  }
</style>
