---
import Wordmark from './Wordmark.astro'
import {clean} from '../sanity/lib/stega'

interface Props {
  navLinks?: {label: string; href: string}[]
  githubUrl?: string
}

const {navLinks: rawLinks = [], githubUrl: rawGithub} = Astro.props

// hrefs go into attributes and get compared against the current path.
const navLinks = rawLinks.map((l) => ({...l, href: clean(l.href)}))
const githubUrl = clean(rawGithub)
const path = Astro.url.pathname

const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`)
---

<header class="header">
  <a class="skip" href="#main">Skip to content</a>

  <div class="header__bar glass">
    <a class="header__brand" href="/" aria-label="kvidr — home">
      <Wordmark size={20} />
    </a>

    <nav class="header__nav" aria-label="Primary">
      {
        navLinks.map((l) => (
          <a
            class="header__link"
            href={l.href}
            aria-current={isCurrent(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    {
      githubUrl && (
        <a class="header__gh" href={githubUrl} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
          </svg>
          <span>GitHub</span>
        </a>
      )
    }
  </div>
</header>

<style>
  .skip {
    position: absolute;
    top: -4rem;
    left: 1rem;
    z-index: 100;
    padding: 0.6rem 1rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.875rem;
    transition: top 0.2s var(--ease);
  }

  .skip:focus {
    top: 1rem;
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 0.75rem var(--gutter);
    pointer-events: none;
  }

  .header__bar {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 3vw, 2rem);
    max-width: var(--shell);
    margin-inline: auto;
    padding: 0.4rem 0.5rem 0.4rem 0.95rem;
    border-radius: 999px;
  }

  .header__brand {
    display: flex;
    flex: none;
  }

  /* On a narrow phone the mark alone buys back enough width for the whole
     nav to fit, which beats a link cut in half. */
  @media (max-width: 26rem) {
    .header__brand :global(.wordmark__word) {
      display: none;
    }
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 1.4rem);
    margin-left: auto;
    min-width: 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  /* When the links do not fit, fade the trailing edge so it reads as
     scrollable rather than as a link that got cut in half. */
  @media (max-width: 40rem) {
    .header__nav {
      mask-image: linear-gradient(to right, #000 calc(100% - 1.5rem), transparent 100%);
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 1.5rem), transparent 100%);
      padding-right: 1.25rem;
    }
  }

  .header__nav::-webkit-scrollbar {
    display: none;
  }

  .header__link {
    position: relative;
    padding: 0.3rem 0.1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink-2);
    white-space: nowrap;
    transition: color 0.2s var(--ease);
  }

  .header__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.05rem;
    height: 1.5px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out);
  }

  .header__link:hover,
  .header__link[aria-current='page'] {
    color: var(--ink);
  }

  .header__link:hover::after,
  .header__link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .header__gh {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex: none;
    padding: 0.42rem 0.9rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.8125rem;
    font-weight: 550;
    transition: opacity 0.2s var(--ease);
  }

  .header__gh:hover {
    opacity: 0.86;
  }

  @media (max-width: 40rem) {
    .header__gh span {
      display: none;
    }

    .header__gh {
      padding: 0.45rem 0.55rem;
    }

    .header__bar {
      padding-left: 0.75rem;
      gap: 0.6rem;
    }

    .header__link {
      font-size: 0.8125rem;
    }
  }
</style>
