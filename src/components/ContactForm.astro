---
---

<form class="cform" data-contact novalidate>
  <div class="cform__grid">
    <p class="cform__field">
      <label for="cf-name">Your name</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required />
    </p>

    <p class="cform__field">
      <label for="cf-email">Email</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required />
    </p>
  </div>

  <p class="cform__field">
    <label for="cf-message">Message</label>
    <textarea id="cf-message" name="message" rows={7} required></textarea>
  </p>

  <p class="cform__honeypot" aria-hidden="true">
    <label for="cf-company">Company</label>
    <input id="cf-company" name="company" type="text" tabindex="-1" autocomplete="off" />
  </p>

  <div class="cform__foot">
    <button class="btn btn--accent" type="submit">
      <span data-idle>Send message</span>
      <span data-busy hidden>Sending…</span>
    </button>
    <p class="t-small cform__status" data-status role="status" aria-live="polite" hidden></p>
  </div>
</form>

<style>
  .cform {
    max-width: 34rem;
  }

  .cform__grid {
    display: grid;
    gap: 1.1rem;
  }

  @media (min-width: 34rem) {
    .cform__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .cform__field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-block: 0 1.1rem;
  }

  .cform__grid .cform__field {
    margin-bottom: 0;
  }

  .cform__grid + .cform__field {
    margin-top: 1.1rem;
  }

  .cform label {
    font-size: 0.8125rem;
    font-weight: 550;
    color: var(--ink-2);
  }

  .cform input,
  .cform textarea {
    width: 100%;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-s);
    background: var(--paper-raised);
    font-size: 0.9375rem;
    font-family: inherit;
    resize: vertical;
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }

  .cform input:focus,
  .cform textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-wash);
  }

  .cform__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .cform__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .cform__status {
    margin: 0;
  }

  .cform__status[data-state='ok'] {
    color: var(--accent);
  }

  .cform__status[data-state='error'] {
    color: #b4483d;
  }

  @media (prefers-color-scheme: dark) {
    .cform__status[data-state='error'] {
      color: #e58a7e;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-contact]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-status]')!
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!
    const idle = button.querySelector<HTMLElement>('[data-idle]')!
    const busy = button.querySelector<HTMLElement>('[data-busy]')!

    const say = (message: string, state: 'ok' | 'error') => {
      status.textContent = message
      status.dataset.state = state
      status.hidden = false
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault()

      if (!form.checkValidity()) {
        say('Please fill in every field.', 'error')
        form.querySelector<HTMLInputElement>(':invalid')?.focus()
        return
      }

      const data = Object.fromEntries(new FormData(form).entries())

      button.disabled = true
      idle.hidden = true
      busy.hidden = false

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify(data),
        })
        const result = await response.json().catch(() => ({}))

        if (response.ok) {
          form.reset()
          say(result.message ?? 'Thank you — your message is on its way.', 'ok')
        } else {
          say(result.message ?? 'Something went wrong. Try again in a moment.', 'error')
        }
      } catch {
        say('Could not reach the server. Try again in a moment.', 'error')
      } finally {
        button.disabled = false
        idle.hidden = false
        busy.hidden = true
      }
    })
  })
</script>
